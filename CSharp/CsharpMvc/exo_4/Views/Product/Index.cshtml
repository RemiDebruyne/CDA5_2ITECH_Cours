@Model List<Product>
@{
    ViewData["Title"] = "Index";
}

    <h1>Index</h1>

    <button type="button" class="btn btn-primary">
        <a class="nav-link text-dark" asp-area="" asp-controller="Product" asp-action="Create">Create random</a>
    </button>

@foreach (var product in Model)
{
        <p>@product.Id</p>
        <p>@product.Name</p>
        <p>@product.Price</p>
        <p>@product.Stock</p>
        <button type="button" class="btn btn-danger">
            <a class="nav-link text-dark" asp-area="" asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id">Delete</a>
        </button>
}
