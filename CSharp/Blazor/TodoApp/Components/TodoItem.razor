@using TodoApp.Models

<div style="display:flex;gap:16px;">
    <div style="display:flex;gap:16px;">
        <input type="checkbox" @onchange="HandleChange" />
        <p>@Todo.Task</p>
    </div>

    <div style="display:flex;gap:16px;">
        @if (IsDateDisplayed)
        {
            <p>@Todo.CreationDate</p>
        }
        <button @onclick="() => OnDelete.InvokeAsync(Todo)">Supprimer</button>
        <p>@(Todo.IsCompleted ? "TERMINE" : "PAS TERMINE")</p>
    </div>


</div>

@code {
    [Parameter]
    public Todo Todo { get; set; }

    [Parameter]
    public bool IsDateDisplayed { get; set; }

    [Parameter]
    public EventCallback<Todo> OnDelete { get; set; }


    [Parameter]
    public EventCallback OnChange { get; set; }

    public async Task HandleChange()
    {
        Todo.IsCompleted = !Todo.IsCompleted;
        await OnChange.InvokeAsync();
    }
}
